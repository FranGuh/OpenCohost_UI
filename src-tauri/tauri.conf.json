{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCohost Shell Prototype",
  "version": "0.0.0",
  "identifier": "com.opencohost.shell.prototype",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenCohost Shell Prototype",
        "width": 1440,
        "height": 950,
        "minWidth": 1280,
        "minHeight": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
