{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCohost",
  "version": "0.1.1",
  "identifier": "com.opencohost.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenCohost",
        "width": 1440,
        "height": 950,
        "minWidth": 1280,
        "minHeight": 820,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#05070b",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "backend.config.default.json": "backend.config.json"
    }
  }
}
