Var PassiveMode
Var UpdateMode
Var NoShortcutMode
Var WixMode
Var OldMainBinaryName
Var OpenCohostBackendState
Var OpenCohostDataRoot
Var OpenCohostLockPath

!ifndef OPENCOHOST_RUNTIME_KEY
  !define OPENCOHOST_RUNTIME_KEY "Software\OpenCohost\Runtime"
!endif

; Refuse file mutations while the application or its owned backend is alive.
; The backend writes a decimal PID to the runtime lock file. Its image must be
; this install's bootstrap Python or a Python under the managed DataRoot layout.
; Failure to inspect an existing lock is fail-closed; unrelated Python is ignored.
!macro DefineOpenCohostProcessGuard PREFIX LABEL
Function ${PREFIX}IsOwnedBackendRunning
  Push $0
  Push $1
  Push $2
  Push $3
  Push $4
  Push $5
  Push $6
  Push $7
  Push $8
  Push $9
  Push $R0
  Push $R1
  Push $R2
  Push $R3
  Push $R4
  Push $R5
  Push $R6
  Push $R7
  Push $R8
  Push $R9

  StrCpy $OpenCohostBackendState 0
  ReadRegStr $OpenCohostDataRoot HKCU "${OPENCOHOST_RUNTIME_KEY}" "DataRoot"
  ${If} $OpenCohostDataRoot == ""
    StrCpy $OpenCohostLockPath "$TEMP\opencohost_api_engine.lock"
  ${Else}
    StrCpy $OpenCohostLockPath "$OpenCohostDataRoot\state\opencohost_api_engine.lock"
  ${EndIf}

  IfFileExists "$OpenCohostLockPath" 0 ${LABEL}backend_not_running
  ClearErrors
  FileOpen $R2 "$OpenCohostLockPath" r
  IfErrors ${LABEL}backend_unverified
  FileRead $R2 $R3
  FileClose $R2
  ${If} $R3 == ""
    Goto ${LABEL}backend_unverified
  ${EndIf}
  ; The lock is written as decimal str(os.getpid()) with no newline. Round-trip
  ; validation rejects partial numbers instead of silently coercing them to 0.
  IntOp $R4 $R3 + 0
  IntFmt $R5 "%u" $R4
  ${If} $R5 != $R3
    Goto ${LABEL}backend_invalid_pid
  ${EndIf}
  ${If} $R4 = 0
    Goto ${LABEL}backend_invalid_pid
  ${EndIf}

  ; ?e captures GetLastError immediately, before another plugin call can clobber it.
  System::Call 'kernel32::OpenProcess(i 0x1000, i 0, i $R4) p .r4 ?e'
  Pop $R5
  ${If} $4 P= 0
    ${If} $R5 = 87
      Goto ${LABEL}backend_not_running
    ${Else}
      Goto ${LABEL}backend_unverified
    ${EndIf}
  ${EndIf}

  System::Call 'kernel32::GetExitCodeProcess(p r4, *i .r5) i .r6'
  ${If} $6 = 0
    System::Call 'kernel32::CloseHandle(p r4)'
    Goto ${LABEL}backend_unverified
  ${EndIf}
  ${If} $5 != 259
    System::Call 'kernel32::CloseHandle(p r4)'
    Goto ${LABEL}backend_not_running
  ${EndIf}

  ; System::Call .r5/.r6 write NSIS $5/$6 (not $R5/$R6).
  System::Call 'kernel32::QueryFullProcessImageNameW(p r4, i 0, w .r5, *i ${NSIS_MAX_STRLEN} r6) i .r7'
  System::Call 'kernel32::CloseHandle(p r4)'
  ${If} $7 = 0
    Goto ${LABEL}backend_unverified
  ${EndIf}
  !if "${PREFIX}" == ""
    ${StrCase} $R5 "$5" "L"
    ${StrCase} $R6 "$INSTDIR\resources\runtime\python\python.exe" "L"
  !else
    ${UnStrCase} $R5 "$5" "L"
    ${UnStrCase} $R6 "$INSTDIR\resources\runtime\python\python.exe" "L"
  !endif
  ${If} $R5 == $R6
    StrCpy $OpenCohostBackendState 1
    Goto ${LABEL}backend_restore_registers
  ${EndIf}

  ; Provisioned runtimes execute from
  ; DataRoot\engine\releases\<version>\generations\<id>\venv\Scripts\python.exe.
  ; The trailing slash in the prefix enforces a path-component boundary.
  ${If} $OpenCohostDataRoot == ""
    Goto ${LABEL}backend_not_running
  ${EndIf}
  StrCpy $R6 "$OpenCohostDataRoot\engine\releases\"
  !if "${PREFIX}" == ""
    ${StrCase} $R5 "$5" "L"
    ${StrCase} $R6 "$R6" "L"
  !else
    ${UnStrCase} $R5 "$5" "L"
    ${UnStrCase} $R6 "$R6" "L"
  !endif
  StrLen $R7 $R6
  StrCpy $R8 $R5 $R7
  ${If} $R8 != $R6
    Goto ${LABEL}backend_not_running
  ${EndIf}
  StrCpy $R9 $R5 ${NSIS_MAX_STRLEN} $R7
  !if "${PREFIX}" == ""
    ${StrLoc} $R4 $R9 "\generations\" ">"
  !else
    ${UnStrLoc} $R4 $R9 "\generations\" ">"
  !endif
  ${If} $R4 < 1
    Goto ${LABEL}backend_not_running
  ${EndIf}
  IntOp $R3 $R4 + 13
  StrCpy $R3 $R9 ${NSIS_MAX_STRLEN} $R3
  StrCpy $R8 $R3 1
  StrCmp $R8 "\" ${LABEL}backend_not_running
  !if "${PREFIX}" == ""
    ${StrLoc} $R8 $R3 "\" ">"
  !else
    ${UnStrLoc} $R8 $R3 "\" ">"
  !endif
  ${If} $R8 < 1
    Goto ${LABEL}backend_not_running
  ${EndIf}
  StrLen $R7 $R5
  StrLen $R8 "\venv\Scripts\python.exe"
  IntOp $R7 $R7 - $R8
  ${If} $R7 <= $R4
    Goto ${LABEL}backend_not_running
  ${EndIf}
  StrCpy $R8 $R5 $R8 $R7
  !if "${PREFIX}" == ""
    ${StrCase} $R8 "$R8" "L"
    ${StrCase} $R6 "\venv\Scripts\python.exe" "L"
  !else
    ${UnStrCase} $R8 "$R8" "L"
    ${UnStrCase} $R6 "\venv\Scripts\python.exe" "L"
  !endif
  ${If} $R8 == $R6
    StrCpy $OpenCohostBackendState 1
    Goto ${LABEL}backend_restore_registers
  ${EndIf}
  Goto ${LABEL}backend_not_running

  ${LABEL}backend_invalid_pid:
    Goto ${LABEL}backend_unverified
  ${LABEL}backend_unverified:
    StrCpy $OpenCohostBackendState 2
    Goto ${LABEL}backend_restore_registers
  ${LABEL}backend_not_running:
    StrCpy $OpenCohostBackendState 0
  ${LABEL}backend_restore_registers:
  Pop $R9
  Pop $R8
  Pop $R7
  Pop $R6
  Pop $R5
  Pop $R4
  Pop $R3
  Pop $R2
  Pop $R1
  Pop $R0
  Pop $9
  Pop $8
  Pop $7
  Pop $6
  Pop $5
  Pop $4
  Pop $3
  Pop $2
  Pop $1
  Pop $0
FunctionEnd

Function ${PREFIX}CheckOpenCohostProcesses
  !if "${INSTALLMODE}" == "currentUser"
    nsis_tauri_utils::FindProcessCurrentUser "${MAINBINARYNAME}.exe"
  !else
    nsis_tauri_utils::FindProcess "${MAINBINARYNAME}.exe"
  !endif
  Pop $R0
  ; The plugin's established contract is 0=found and 1=not found. Treat any
  ; unexpected result as unsafe rather than interpreting it as process-free.
  ${If} $R0 != 1
    Goto ${LABEL}process_busy
  ${EndIf}
  Call ${PREFIX}IsOwnedBackendRunning
  ${If} $OpenCohostBackendState != 0
    Goto ${LABEL}process_busy
  ${EndIf}
  Return

  ${LABEL}process_busy:
    IfSilent ${LABEL}process_abort
    ${If} $PassiveMode = 1
      Goto ${LABEL}process_abort
    ${EndIf}
    MessageBox MB_OKCANCEL|MB_ICONEXCLAMATION "$(appRunning)" IDOK ${LABEL}process_recheck IDCANCEL ${LABEL}process_abort
  ${LABEL}process_recheck:
    !if "${INSTALLMODE}" == "currentUser"
      nsis_tauri_utils::FindProcessCurrentUser "${MAINBINARYNAME}.exe"
    !else
      nsis_tauri_utils::FindProcess "${MAINBINARYNAME}.exe"
    !endif
    Pop $R0
    ${If} $R0 != 1
      Goto ${LABEL}process_abort
    ${EndIf}
    Call ${PREFIX}IsOwnedBackendRunning
    ${If} $OpenCohostBackendState != 0
      Goto ${LABEL}process_abort
    ${EndIf}
    Return
  ${LABEL}process_abort:
    Abort
FunctionEnd
!macroend

!insertmacro DefineOpenCohostProcessGuard "" "installer_"
!insertmacro DefineOpenCohostProcessGuard "un." "uninstaller_"

Name "${PRODUCTNAME}"
BrandingText "${COPYRIGHT}"
OutFile "${OUTFILE}"

; We don't actually use this value as default install path,
; it's just for nsis to append the product name folder in the directory selector
; https://nsis.sourceforge.io/Reference/InstallDir
!define PLACEHOLDER_INSTALL_DIR "placeholder\${PRODUCTNAME}"
InstallDir "${PLACEHOLDER_INSTALL_DIR}"

VIProductVersion "${VERSIONWITHBUILD}"
VIAddVersionKey "ProductName" "${PRODUCTNAME}"
VIAddVersionKey "CompanyName" "${MANUFACTURER}"
VIAddVersionKey "FileDescription" "${PRODUCTNAME}"
VIAddVersionKey "LegalCopyright" "${COPYRIGHT}"
VIAddVersionKey "FileVersion" "${VERSION}"
VIAddVersionKey "ProductVersion" "${VERSION}"


; Uninstaller signing command
!if "${UNINSTALLERSIGNCOMMAND}" != ""
  !uninstfinalize '${UNINSTALLERSIGNCOMMAND}'
!endif

; Handle install mode, `perUser`, `perMachine` or `both`
!if "${INSTALLMODE}" == "perMachine"
  RequestExecutionLevel admin
!endif

!if "${INSTALLMODE}" == "currentUser"
  RequestExecutionLevel user
!endif

!if "${INSTALLMODE}" == "both"
  !define MULTIUSER_MUI
  !define MULTIUSER_INSTALLMODE_INSTDIR "${PRODUCTNAME}"
  !define MULTIUSER_INSTALLMODE_COMMANDLINE
  !if "${ARCH}" == "x64"
    !define MULTIUSER_USE_PROGRAMFILES64
  !else if "${ARCH}" == "arm64"
    !define MULTIUSER_USE_PROGRAMFILES64
  !endif
  !define MULTIUSER_INSTALLMODE_DEFAULT_REGISTRY_KEY "${UNINSTKEY}"
  !define MULTIUSER_INSTALLMODE_DEFAULT_REGISTRY_VALUENAME "CurrentUser"
  !define MULTIUSER_INSTALLMODEPAGE_SHOWUSERNAME
  !define MULTIUSER_INSTALLMODE_FUNCTION RestorePreviousInstallLocation
  !define MULTIUSER_EXECUTIONLEVEL Highest
  !include MultiUser.nsh
!endif

; Installer icon
!if "${INSTALLERICON}" != ""
  !define MUI_ICON "${INSTALLERICON}"
!endif

; Installer sidebar image
