{"openapi": "3.1.0", "info": {"title": "FastAPI", "version": "0.1.0"}, "paths": {"/api/health": {"get": {"summary": "Get Health", "operationId": "get_health_api_health_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthResponse"}}}}}}}, "/api/status": {"get": {"summary": "Get Status", "operationId": "get_status_api_status_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StatusResponse"}}}}}}}, "/api/perfiles": {"get": {"summary": "List Perfiles", "operationId": "list_perfiles_api_perfiles_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProfilesListResponse"}}}}}}}, "/api/models": {"get": {"summary": "Get Models", "operationId": "get_models_api_models_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ModelsResponse"}}}}}}}, "/api/tts/config": {"get": {"summary": "Get Tts Config", "operationId": "get_tts_config_api_tts_config_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TTSConfigResponse"}}}}}}}, "/api/memoria/stats": {"get": {"summary": "Get Memoria Stats", "operationId": "get_memoria_stats_api_memoria_stats_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MemoriaStatsResponse"}}}}}}}, "/api/perfiles/switch": {"post": {"summary": "Switch Profile", "operationId": "switch_profile_api_perfiles_switch_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/SwitchProfileRequest"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/jso