bject", "required": ["display", "desc", "size_gb", "family"], "title": "ModelCatalogEntry", "description": "Mirrors one entry of `opencohost.config.settings.MODELS_CATALOG`."}, "ModelsResponse": {"properties": {"catalog": {"additionalProperties": {"$ref": "#/components/schemas/ModelCatalogEntry"}, "type": "object", "title": "Catalog"}, "discovered": {"items": {"type": "string"}, "type": "array", "title": "Discovered"}, "current_model": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Current Model"}, "tiers": {"additionalProperties": {"type": "string"}, "type": "object", "title": "Tiers"}, "active_tier": {"type": "string", "title": "Active Tier"}}, "type": "object", "required": ["catalog", "discovered", "current_model", "tiers", "active_tier"], "title": "ModelsResponse", "description": "GET /api/models (Tier B, direct read).\n\n`discovered` degrades to `[]` when live Ollama discovery times out or\nerrors \u2014 the catalog + tiers still resolve to safe catalog-only values."}, "ProfilesListResponse": {"properties": {"profiles": {"items": {"type": "string"}, "type": "array", "title": "Profiles"}}, "type": "object", "required": ["profiles"], "title": "ProfilesListResponse", "description": "Profile NAMES only \u2014 never persona text, prompts, or other fields."}, "StatusResponse": {"properties": {"is_ready": {"type": "boolean", "title": "Is Ready"}, "current_model": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Current Model"}, "is_speaking": {"type": "boolean", "title": "Is Speaking"}, "is_processing": {"type": "boolean", "title": "Is Processing"}, "active_profile": {"type": "string", "title": "Active Profile"}, "health": {"$ref": "#/components/schemas/HealthState"}, "state_version": {"type": "integer", "title": "State Version"}}, "type": "object", "required": ["is_ready", "current_model", "is_speaking", "is_processing", "active_profile", "health", "state_version"], "title": "StatusResponse"}, "SwitchProfileRequest": {"properties": {"name": {"type": "string", "title": "Name"}, "idempotency_key": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Idempotency Key"}}, "type": "object", "required": ["name"], "title": "SwitchProfileRequest"}, "TTSConfigResponse": {"properties": {"piper_voice": {"type": "string", "title": "Piper Voice"}, "local_only": {"type": "boolean", "title": "Local Only"}, "speed": {"type": "number", "title": "Speed"}, "engine": {"type": "string", "title": "Engine"}, "heavy_available": {"type": "boolean", "title": "Heavy Available"}}, "type": "object", "required": ["piper_voice", "local_only", "speed", "engine", "heavy_available"], "title": "TTSConfigResponse", "description": "GET /api/tts/config (Tier B, direct read). Pure config read, no I/O timeout needed."}, "ValidationError": {"properties": {"loc": {"items": {"anyOf": [{"type": "string"}, {"type": "integer"}]}, "type": "array", "title": "Location"}, "msg": {"type": "string", "title": "Message"}, "type": {"type": "string", "title": "Error Type"}, "input": {"title": "Input"}, "ctx": {"type": "object", "title": "Context"}}, "type": "object", "required": ["loc", "msg", "type"], "title": "ValidationError"}}}}
